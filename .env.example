# Copy this file to .env and fill in values. Do not commit .env.

# --- Cloud (recommended for --vision) ---
# Google AI Studio free key, used first for Gemini 3.7 Flash (locate + translate).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ZenMux fallback if Google is 429/503 or blocks a request.
# https://zenmux.ai
ZENMUX_API_KEY=

# Optional. Default model on ZenMux:
# VISION_MODEL=google/gemini-3.7-flash

# --- Local (Mode A erase + optional no-vision OCR/translate) ---
# Clone of https://github.com/zyddnys/manga-image-translator
MIT_ROOT=D:\manga-image-translator

# Only needed without --vision (local uncensored translator):
# OLLAMA_HOST=http://127.0.0.1:11434/api/chat
# OLLAMA_MODEL=qwen3.8:27b-uncensored

# Optional overrides:
# LETTER_NAMES=./names.json
# LETTER_LOG_DIR=./logs
