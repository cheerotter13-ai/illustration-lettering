# Copy to engine/.env or export in the shell. Do not commit real keys.
# OpenAI-compat (recommended):
LETTER_OPENAI_BASE=https://zenmux.ai/api/v1
LETTER_OPENAI_KEY=
LETTER_OPENAI_MODEL=google/gemini-3.7-flash

# Or Gemini / ZenMux without OpenAI-compat:
# GEMINI_API_KEY=
# ZENMUX_API_KEY=
# VISION_MODEL=google/gemini-3.7-flash
